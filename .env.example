# Pick ONE provider and paste its key. With no key at all, pocket falls back to a
# scripted offline model so the demo and the eval suite still run.
POCKET_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# POCKET_PROVIDER=openai
# OPENAI_API_KEY=

# POCKET_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

# POCKET_PROVIDER=kimi
# MOONSHOT_API_KEY=

# --- optional knobs (defaults shown)
# POCKET_HOME=.pocket
# POCKET_MODEL=
# POCKET_SMALL_MODEL=
# POCKET_MAX_ITERATIONS=8
# POCKET_HISTORY_TURNS=8
# POCKET_CONSOLIDATE_EVERY=3
# POCKET_TOOL_RESULT_LIMIT=2000
# POCKET_CONTEXT_BUDGET=12000
# POCKET_SUBAGENTS=1
# register assign_team: several workers over one shared board (docs/teams.md)
# POCKET_TEAM=0
# POCKET_GRAPH_WORKFLOWS=0
# tools pre-approved for the session, comma separated (skips the permission prompt)
# POCKET_TRUST=mcp__demo__word_count
